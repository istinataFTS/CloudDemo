<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garage</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" href="/">Garage</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex gap-3 align-items-center">
                        <a href="/posts/new">New post</a>
                        <a href="/u/@User.Identity.Name">&#64;@User.Identity.Name</a>
                        <form method="post" asp-page="/Account/Logout" class="m-0">
                            <button type="submit" class="btn btn-link p-0">Log out</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3">
                        <a href="/login">Log in</a>
                        <a href="/register">Join</a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @* One centred column, as in the mockup. Every page sits in it. *@
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
