@page "/register"
@model Garage.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Join";
}

<h1>Join Garage</h1>

<form method="post">
    <div asp-validation-summary="All"></div>

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" autocomplete="email" />

    <label asp-for="Input.Username">Username</label>
    <input asp-for="Input.Username" autocomplete="username" placeholder="ivan_w124" />

    <label asp-for="Input.DisplayName">Display name</label>
    <input asp-for="Input.DisplayName" autocomplete="name" placeholder="Ivan Petrov" />

    <label asp-for="Input.Bio">About you and your car</label>
    <textarea asp-for="Input.Bio"></textarea>

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" autocomplete="new-password" />

    <button type="submit">Create account</button>
</form>

<p>Already have an account? <a href="/login">Log in</a>.</p>
