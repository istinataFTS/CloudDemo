@page "/posts/new"
@model Garage.Pages.Posts.NewModel
@{
    ViewData["Title"] = "New post";
}

<h1>New post</h1>

<form method="post">
    <div asp-validation-summary="All"></div>

    <label asp-for="Input.Body">What's on your mind — or in your garage?</label>
    <textarea asp-for="Input.Body" rows="5" cols="60"></textarea>

    <button type="submit">Post</button>
</form>

<p>Photos are added on the next page, once the post exists.</p>
