@page
@using Garage.Mockup
@model IndexModel
@{
    ViewData["Title"] = "Feed";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="alert alert-warning py-2 small">
            Mockup &mdash; hardcoded data, no database yet. Replaced at Task 5.
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <textarea class="form-control border-0 p-0 mb-2" rows="2"
                          placeholder="What are you working on?" disabled></textarea>
                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-sm btn-outline-secondary" disabled>Add photos</button>
                    <button class="btn btn-sm btn-dark" disabled>Post</button>
                </div>
            </div>
        </div>

        @foreach (var post in Model.Posts)
        {
            <partial name="_Post" model="post" />
        }

    </div>
</div>
