@page
@model IndexModel
@{
    ViewData["Title"] = "Feed";
}

@* The composer from the mockup, now real. It posts to the same handler as
   /posts/new; photos are added on the post's own page, once it exists. *@
<form method="post" asp-page="/Posts/New" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <textarea name="Input.Body" class="form-control border-0 p-0 mb-2" rows="2"
                  maxlength="2000" placeholder="What are you working on?"></textarea>
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Photos go on the next page.</small>
            <button type="submit" class="btn btn-sm btn-dark">Post</button>
        </div>
    </div>
</form>

<partial name="_PostList" model="Model.Feed" />
